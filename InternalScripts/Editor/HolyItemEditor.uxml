<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.holyperson.holyitemeditor/InternalScripts/Editor/HolyItemEditor.uss?fileID=7433441132597879392&amp;guid=7c4d90d7a5f9e944ab9e664a179cbab7&amp;type=3#HolyItemEditor"/>
    <ui:VisualElement name="Root" class="upper-panel" style="flex-grow: 1; flex-shrink: 1; min-height: 0; align-content: stretch;">
        <ui:VisualElement name="Panels" style="flex-grow: 1; flex-direction: row; flex-shrink: 1; min-height: 0; align-content: auto;">
            <ui:VisualElement name="List" class="upper-panel" style="flex-grow: 0; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; flex-basis: auto; flex-shrink: 1; aspect-ratio: auto; max-width: 250px; width: auto; min-width: 250px; min-height: 0;">
                <ui:VisualElement name="TopPanel" class="upper-panel" style="flex-grow: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 12px; padding-left: 0; flex-shrink: 0;">
                    <ui:VisualElement name="SearchPanel" style="flex-grow: 0; flex-direction: row; flex-shrink: 1; align-content: auto; align-self: stretch; justify-content: flex-start; align-items: auto; width: auto; height: auto; flex-wrap: nowrap;">
                        <ui:TextField label="" placeholder-text="Search" name="SearchField" style="flex-grow: 1;"/>
                        <ui:Button text="?" name="SearchGuide" tooltip="Search Guide" style="flex-grow: 0; align-self: center; aspect-ratio: 1; height: auto; flex-shrink: 1; justify-content: flex-start; align-items: auto; align-content: stretch;"/>
                        <ui:Button text="" name="CreateNewButton" icon-image="project://database/Packages/com.unity.render-pipelines.core/Editor/LookDev/Icons/d_Add.png?fileID=21300000&amp;guid=160b197aba549514286b94426ceae589&amp;type=3#d_Add" tooltip="Create New ScriptableObjects" style="flex-grow: 0; align-self: center; aspect-ratio: 1; height: auto; flex-shrink: 1; justify-content: flex-start; align-items: auto; align-content: stretch; -unity-text-align: upper-center; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ListView name="ItemListView" style="flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Properties" class="propery-panel" style="flex-grow: 1; flex-shrink: 0; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; justify-content: flex-start; align-self: auto; align-content: auto; align-items: stretch; flex-direction: column;">
                <ui:VisualElement name="SelectedDetails" style="flex-grow: 1; flex-direction: row; max-height: 70px; align-content: stretch; align-self: stretch; justify-content: flex-start; flex-shrink: 0; align-items: center; aspect-ratio: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-wrap: nowrap; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px;">
                    <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10907&amp;guid=0000000000000000f000000000000000&amp;type=0#Background" name="ItemImage" scale-mode="ScaleToFit" style="flex-grow: 0; flex-basis: auto; height: auto; width: auto; aspect-ratio: 1; flex-shrink: 1; max-height: 50px; align-self: auto; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: column; flex-wrap: nowrap; min-width: 52px; max-width: 50px;"/>
                    <ui:Label text="Selected Item Name" name="ItemName" style="flex-grow: 1; padding-left: 6px; flex-shrink: 0; font-size: 18px; white-space: pre-wrap;"/>
                </ui:VisualElement>
                <ui:ScrollView>
                    <ui:VisualElement name="PropertiesContent" class="propery-panel" style="flex-grow: 0; background-color: rgb(43, 43, 43); flex-shrink: 1;"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ListButtons" class="upper-panel" style="flex-grow: 0; flex-direction: row-reverse; position: relative; right: auto; bottom: 0; top: auto; left: auto; flex-shrink: 1; margin-top: 6px; margin-right: 6px; margin-bottom: 6px; margin-left: 6px; min-height: 20px; align-self: stretch; justify-content: flex-start; align-items: stretch;">
            <ui:Button text="" name="RefreshListButton" icon-image="project://database/Packages/com.unity.render-pipelines.core/Editor/LookDev/Icons/d_Rotation.png?fileID=21300000&amp;guid=abc6ce87642c5c1478a4b107d1c5688a&amp;type=3#d_Rotation" tooltip="Refresh Items" style="flex-shrink: 0; flex-direction: column; flex-grow: 0; margin-bottom: 0; margin-top: 0; min-height: 20px; background-image: none; padding-top: 3px; padding-bottom: 3px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
